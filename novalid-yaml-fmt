#!/usr/bin/env python3
"""Simple indent formater"""
# pylint: disable=too-many-statements
# pylint: disable=too-many-branches
# pylint: disable=invalid-name
# https://github.com/mmlb/yamlfmt

import argparse
import os
import re
import sys
import tempfile

parser = argparse.ArgumentParser()
parser.add_argument("file", help="file to parse", nargs="*")
parser.add_argument(
    "-w", "--write", help="overwrite file with output", action="store_true"
)
args = parser.parse_args()

DEBUG = False  # True / False

RE_COMMENT = re.compile(r"^[\ ]*\#")
RE_DASH = re.compile(r"^[\ ]*(-[\ ]+)?")
RE_DOC_START = re.compile(r"^[\ ]*---")
RE_LEAD_SPACES = re.compile(r"^[\ ]*")


def genSpaces(count, isDash=False):
    """Generate string with lenth=count with spaces[+][" -"]"""
    string = ""
    if isDash:
        count -= 2
    if count > 0:
        string = " " * count
    if isDash:
        string += "- "
    return string


def findLessKey(ar, cursor):
    """Find nearest key in dict"""
    result = None
    while cursor > -1:
        if cursor == 0:
            result = 0
            break
        if cursor in ar:
            result = ar[cursor]
            break
        cursor -= 1
    return result


def round_trip(sout, sin):
    """Main processing function"""
    lastCursor = 0
    lastShift = 0
    posDict = {0: 0}
    out_lines = []
    isDash = False
    for line in sin.readlines():
        if line.strip() == "":
            out_lines.append("")
            continue
        if RE_COMMENT.match(line):  # check comment ('#')
            cursor = RE_COMMENT.match(line).end() - 1
            if cursor == lastCursor:
                tmpVar = lastShift
            elif cursor > lastCursor:
                tmpVar = lastShift + 2
            else:
                tmpVar = cursor
            text = genSpaces(tmpVar) + line.strip() + "\n"
            out_lines.append(text.rstrip("\n"))
            continue
        if RE_DOC_START.match(line):  # ---
            out_lines.append(line.rstrip("\n"))
            continue
        cursor = RE_DASH.match(line).end()
        isDash = False
        dashAddShift = 0
        firstSymbolPos = RE_LEAD_SPACES.match(line).end()
        if cursor > firstSymbolPos:  # deletect lists (- list)
            isDash = True
            dashAddShift = 2
        if isDash and cursor == 2:
            dashAddShift = 0
        if DEBUG:
            print(
                f">>>>>>>>>>>>|{line}"
                f"isDash={isDash}"
                f"\ncursor={cursor}"
                f"\nlastShift= {lastShift}"
                f"\nlastCursor={lastCursor}"
            )
        if cursor > lastCursor:
            if DEBUG:
                print("gen +shift")
            current_shift = lastShift + 2 + dashAddShift
            new_last_shift = lastShift + dashAddShift + 2

            line = genSpaces(current_shift, isDash) + line[cursor:].strip()
            lastCursor = cursor
            lastShift = new_last_shift
            posDict[cursor] = lastShift

        elif cursor < lastCursor:
            tmpVar = findLessKey(posDict, cursor)
            if DEBUG:
                print("gen -shift")
                print(f"tmpVar={tmpVar}")
                print(posDict)
            line = genSpaces(tmpVar, isDash) + line[cursor:].strip()
            lastCursor = cursor
            lastShift = tmpVar

        else:  # cursor=lastCursor
            if DEBUG:
                print("gen =shift")
            line = genSpaces(lastShift, isDash) + line[cursor:].strip()
            lastCursor = cursor
        out_lines.append(line)
    text = "\n".join(out_lines)
    if out_lines:
        text += "\n"
    if DEBUG:
        print("############\n\n" + text)
    else:
        sout.write(text)


def make_temp_file(name):
    """Make uniq temp file"""
    basename = os.path.basename(name)
    dirname = os.path.dirname(name)
    fd, outname = tempfile.mkstemp(prefix=basename + ".", dir=dirname)
    stat = os.stat(name)
    os.fchmod(fd, stat.st_mode)
    os.fchown(fd, stat.st_uid, stat.st_gid)
    os.close(fd)
    return outname


def main():
    """main"""
    if args.write and not args.file:
        parser.error("write requires at least one file")

    file_out = None
    if not args.file:
        round_trip(sys.stdout, sys.stdin)
        sys.exit(0)

    if not args.write:
        file_out = sys.stdout

    for file in args.file:
        if args.write:
            file_out = make_temp_file(file)

        with open(file, "r", encoding="utf8") as sin:
            if args.write:
                with open(file_out, "w", encoding="utf8") as sout:
                    round_trip(sout, sin)
            else:
                round_trip(sys.stdout, sin)

        if args.write:
            os.rename(file_out, file)


if __name__ == "__main__":
    sys.exit(main())
