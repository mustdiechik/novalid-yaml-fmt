---
extraEnvVars:
  - name: KC_DB_POOL_INITIAL_SIZE
    value: "2"
  - name: KC_DB_POOL_MIN_SIZE
    value: "2"
  - name: KC_DB_POOL_MAX_SIZE
    value: "5"
  - name: JAVA_OPTS_APPEND
    value: >-
      -Dquarkus.datasource.jdbc.idle-removal-interval=30S
      -Dquarkus.datasource.jdbc.background-validation-interval=20S
      -Dquarkus.datasource.jdbc.validate-on-borrow=true
      -Dquarkus.datasource.jdbc.acquisition-timeout=3S
      -Djgroups.dns.query={{ .Release.Name }}-headless.{{ .Release.Namespace }}.svc.cluster.local {{/* from default config to prevent overwrite */}}
